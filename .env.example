# Address the server binds to. Under Docker, PORT also sets the published
# port in docker-compose.yml.
PORT=3000
HOST=0.0.0.0

# Where the SQLite database and saved screenshots live (default ./data), and
# where login profiles are read from (default ./profiles).
# CLAWSOME_DATA_DIR=
# CLAWSOME_PROFILES_DIR=

# How often the server captures each live context for the screenshot history,
# in seconds (default 3). A frame is also captured after every goto and exec.
# Set to 0 to capture only when someone is watching the dashboard.
# CLAWSOME_CAPTURE_INTERVAL=3

# Floor on how often a captured frame is written to disk, in seconds (default
# 1). This caps the setting above: lowering CLAWSOME_CAPTURE_INTERVAL below
# this value captures more often but saves no more. Frames written after a
# goto or exec ignore the floor, as do frames uploaded by external contexts.
# CLAWSOME_SCREENSHOT_MIN_SAVE_INTERVAL=1

# Screenshot retention: keep at most this many frames per context (default
# 500), and delete frames older than this many days (default 7). Set either
# to 0 to switch that rule off — 0 for both keeps everything forever.
# CLAWSOME_SCREENSHOT_LIMIT=500
# CLAWSOME_SCREENSHOT_MAX_AGE_DAYS=7

# Destroy contexts with no API activity for this many seconds (default 1800).
# Set to 0 to disable expiry entirely.
# CLAWSOME_CONTEXT_TTL=1800

# Optional: require `Authorization: Bearer <token>` on all /api/* requests.
# Leave unset to run the API unauthenticated (fine for localhost-only use).
# CLAWSOME_TOKEN=
